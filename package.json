{
  "name": "clothify-lab3",
  "private": true,
  "scripts": {
    "lint": "eslint . && npm --prefix frontend run lint",
    "test:unit": "c8 node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=unit.xml backend/tests/*.unit.test.js tests/*.unit.test.js",
    "test:integration": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=integration.xml backend/tests/integration.test.js",
    "test:e2e": "playwright test",
    "build": "npm --prefix frontend run build",
    "security": "node scripts/audit.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.60.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.0",
    "globals": "^16.5.0"
  }
}
